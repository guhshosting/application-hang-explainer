execute_process(COMMAND "${TEST_EXE}" RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE errors TIMEOUT 10 ENCODING UTF-8)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Synthetic report generation failed: ${errors}")
endif()
string(JSON schema GET "${report}" schema_version)
string(JSON version GET "${report}" application_version)
string(JSON raw_type GET "${report}" wait_chains 0 nodes 4 raw_type)
string(JSON raw_status GET "${report}" wait_chains 0 nodes 4 raw_status)
string(JSON deadlock GET "${report}" wait_chains 0 deadlock_reported)
string(JSON name GET "${report}" wait_chains 0 nodes 3 object_name)
string(JSON path GET "${report}" target_process image_path)
string(JSON creation_type TYPE "${report}" target_process creation_time_filetime)
if(NOT schema STREQUAL "1.0" OR NOT version STREQUAL "1.0.0" OR NOT raw_type EQUAL 900 OR NOT raw_status EQUAL 901 OR NOT deadlock OR NOT creation_type STREQUAL "NULL")
  message(FATAL_ERROR "JSON contract mismatch")
endif()
if(NOT name STREQUAL "Local\\等待\"\n" OR NOT path STREQUAL "C:\\程序\\app.exe")
  message(FATAL_ERROR "Unicode/escaped JSON did not round trip")
endif()
message(STATUS "Independent CMake JSON parser verified schema, enums, Unicode, escaping, deadlock, and null metadata")
